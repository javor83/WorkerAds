@using GCommon.Services
@model DisplayIndexViewModel

@{
    var list = ViewData[ManageAsk.SUMMARY_BASKET] as SummaryManageAsk;
}
<form method="get"
    asp-controller="@ControllerNavigateViewModel.Home"
    asp-action="@ControllerNavigateViewModel.Home_Index">
    
    <div class="input-group">
        <input type="text" name="kw" value="@Model.ApplyFilter.Keyword"  class="form-control" placeholder="@text_Label.Filter">
        <button class="@BootstrapCSS.button_primary" type="submit">@text_Label.StartFilter</button>
    </div>

  
</form>


@if (list.EmptyBasket)
{
    <div>
        <span class="@list.ClassName()">@text_Label.EmptyAskService</span>
    </div>
}
else
{
    <div>
        <span class="@list.ClassName()">@string.Format(text_Label.AskedService,list.BasketCount)</span>
    </div>
}

<partial name="DataTableListAds" model="@Model" />

<partial name="HomeIndexPager" model="@Model.ApplyFilter" />



@using GCommon.Contracts
@using GCommon.Services
@model DisplayIndexViewModel
@inject ILocalProfiles logas
@{
    var list = ViewData[ManageAsk.SUMMARY_BASKET] as SummaryManageAsk;
}

<vc:succcess-alert caption="@ViewData[text_Label.SuccessApply]"></vc:succcess-alert>

<form method="get"
    asp-controller="@ControllerNavigateViewModel.Home"
    asp-action="@ControllerNavigateViewModel.Home_Index">
    
    <div class="input-group">
        <input type="text" name="kw" value="@Model.ApplyFilter.Keyword"  class="form-control" placeholder="@Localizer["String1"]">
        <button class="@BootstrapCSS.button_primary" type="submit">@Localizer["String2"]</button>
    </div>

  
</form>

<div>
    @if(logas.InRoleUser())
    {
        @if (list.EmptyBasket)
        {
                <a asp-controller="@ControllerNavigateViewModel.UserAsk"
                asp-action="@ControllerNavigateViewModel.UserAsk_Index"
                class="@list.ClassName()">
    
     
                    @Localizer["EmptyAskService"]
    
                </a>
        }else
        {
             <a asp-controller="@ControllerNavigateViewModel.UserAsk"
                asp-action="@ControllerNavigateViewModel.UserAsk_Index"
                class="@list.ClassName()">
   
    
                @string.Format(Localizer["AskedService"].Value, list.BasketCount)
             </a>
        }
    }

   
</div>




<partial name="DataTableListAds" model="@Model" />

<partial name="HomeIndexPager" model="@Model.ApplyFilter" />



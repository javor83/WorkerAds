@model FilterModel
@{
    int[] list = Model.XPage();
}

<ul class="pagination justify-content-center" style="margin:20px 0">

    <li class="page-item">
        <a class="page-link" asp-action="@ControllerNavigateViewModel.Home_Index"
           asp-controller="@ControllerNavigateViewModel.Home"
           asp-route-page="@Model.PreviousPage()" asp-route-kw="@Model.Keyword">@text_Label.PrevPage</a>
    </li>
   
    @foreach (int i in list)
    {
        if (i == Model.CurrentPage)
        {
            <li class="page-item active">
                <a class="page-link"
                   asp-action="@ControllerNavigateViewModel.Home_Index"
                   asp-controller="@ControllerNavigateViewModel.Home"
                   asp-route-page="@i"
                   asp-route-kw="@Model.Keyword">@i</a>
            </li>
        }
        else
        {
            <li class="page-item">
                <a class="page-link" asp-action="@ControllerNavigateViewModel.Home_Index"
                       asp-controller="@ControllerNavigateViewModel.Home"
                       asp-route-page="@i"
                       asp-route-kw="@Model.Keyword">
                    @i
                </a>
            </li>
        }
    }

    
   
 
    <li class="page-item">
        <a class="page-link" asp-action="@ControllerNavigateViewModel.Home_Index"
           asp-controller="@ControllerNavigateViewModel.Home"
           asp-route-page="@Model.NextPage()"
           asp-route-kw="@Model.Keyword">@text_Label.NextPage</a>
    </li>
</ul>

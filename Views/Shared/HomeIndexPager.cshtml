@model FilterModel


<ul class="pagination justify-content-center" style="margin:20px 0">

    <li class="page-item">
        <a class="page-link" asp-action="@ControllerNavigateViewModel.Home_Index"
           asp-controller="@ControllerNavigateViewModel.Home"
           asp-route-page="@Model.PreviousPage()">@text_Label.PrevPage</a>
    </li>

    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        if (i == Model.CurrentPage)
        {
            <li class="page-item active">
                <a class="page-link"
                   asp-action="@ControllerNavigateViewModel.Home_Index"
                   asp-controller="@ControllerNavigateViewModel.Home"
                   asp-route-page="@i">@i</a>
            </li>
        }
        else
        {
            <li class="page-item">
                <a class="page-link" asp-action="@ControllerNavigateViewModel.Home_Index"
                       asp-controller="@ControllerNavigateViewModel.Home"
                       asp-route-page="@i">
                    @i
                </a>
            </li>
        }
    }

    
   
 
    <li class="page-item">
        <a class="page-link" asp-action="@ControllerNavigateViewModel.Home_Index"
           asp-controller="@ControllerNavigateViewModel.Home"
           asp-route-page="@Model.NextPage()">@text_Label.NextPage</a>
    </li>
</ul>

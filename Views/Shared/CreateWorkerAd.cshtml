@model AdvertisementToWorker
<vc:manager-subtitle caption="@string.Format(text_Worker.NewAdOf,Model.WorkerFullName)"></vc:manager-subtitle>

<form method="post"
    asp-controller="@controller_navigate.Worker"
    asp-action="@controller_navigate.Worker_AdsEmpty"
    asp-antiforgery="true">
    <div asp-validation-summary="ModelOnly"></div>
    <input type="hidden" asp-for="@Model.WorkerID" />
    <input type="hidden" asp-for="@Model.WorkerFullName" />

    <div class="form-group">
        <label asp-for="@Model.HourID"></label>
        <select asp-for="@Model.HourID" asp-items="@Model.ComboHours()" class="form-control">
            <option value="">*</option>
        </select>
        <span asp-validation-for="@Model.HourID"></span>
    </div>

    <div class="form-group">
        <label asp-for="@Model.CapabilityID"></label>
        <select asp-for="@Model.CapabilityID" asp-items="@Model.ComboCapability()" class="form-control">
            <option value="">*</option>
        </select>
        <span asp-validation-for="@Model.CapabilityID"></span>

    </div>

    <div class="form-group">
        <label asp-for="@Model.WatchDate"></label>
        <input type="datetime-local" asp-for="@Model.WatchDate" class="form-control" />
        <span asp-validation-for="@Model.WatchDate" ></span>

    </div>


    <div class="form-group">
        <label asp-for="@Model.AdvText"></label>
        <textarea asp-for="@Model.AdvText" class="form-control"></textarea>
        <span asp-validation-for="@Model.AdvText"></span>
    </div>

    <div class="@BootstrapCSS.margin_top_1 @BootstrapCSS.text_center">
        <a asp-controller="@controller_navigate.Worker"
           asp-action="@controller_navigate.Worker_Ads"
           asp-route-id="@Model.WorkerID" class="@BootstrapCSS.button_outline">
            @text_Label.Cancel
        </a>

        <input type="submit" value="@text_Label.Save" class="@BootstrapCSS.button_primary" />
    </div>

</form>


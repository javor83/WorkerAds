@model DisplayIndexViewModel
@using GCommon.Contracts
@inject ILocalProfiles login
@inject IManageAsk manage_ask
<vc:manager-subtitle caption="@text_Label.FreeAds"></vc:manager-subtitle>
<table class="@BootstrapCSS.table">
    <tr>
        <th class="@BootstrapCSS.text_center">@text_Worker.WorkerImage</th>
        <th class="@BootstrapCSS.text_center">@text_Worker.WorkerDetails</th>
        <th class="@BootstrapCSS.text_center">@text_WorkHour.LabelWorkHour</th>
    </tr>
    @foreach (var ads in Model.Data)
    {
        <tr>
            <td class="@BootstrapCSS.text_center">
                
                <img src="@ads.Photo.ImgSrc_PreviewWorker()" class="@BootstrapCSS.img_thumbnail_worker" />
            </td>
            <td>
                <p class="text-center"><strong>@ads.AdvTitle</strong></p>
                <div><b>@ads.FullName()</b></div>
                <div>
                    <b>@text_Worker.WorkerPhone</b> @ads.Phone
                </div>
                <div>
                    <b>@text_Worker.WorkerEmail</b> @ads.Email
                </div>
                <div>
                    <b>@text_WorkCategory.LabelWorkCategory</b> @ads.WhatToDo()

                    

                    <a asp-controller="@ControllerNavigateViewModel.Home" 
                           asp-action="@ControllerNavigateViewModel.Home_Ads" 
                           asp-route-id="@ads.DeclareWorkerFreeID"
                           asp-route-page="@Model.ApplyFilter.CurrentPage"
                           asp-route-kw="@Model.ApplyFilter.Keyword"
                    class="@BootstrapCSS.ReadMoreLess">
                        @text_WorkCategory.ReadMoreLess
                    </a>

                 
                   
                </div>
                
            </td>
            <td class="@BootstrapCSS.text_center">
                 
                       @ads.EveryDay()
                       
                  
                @if (login.InRoleUser() && (manage_ask.Contains(ads.DeclareWorkerFreeID) == false))
                       {
                            <form method="post" 
                                asp-controller="@ControllerNavigateViewModel.UserAsk" 
                                asp-action="@ControllerNavigateViewModel.UserAsk_IncludeAsk"
                                asp-antiforgery="true">
                                <input type="hidden" value="@ads.DeclareWorkerFreeID" name="id" />
                                <input type="hidden" value="@Model.ApplyFilter.CurrentPage" name="page" />
                                <input type="hidden" value="@Model.ApplyFilter.Keyword" name="kw" />
                                    <div>
                                        <input type="submit" value="@text_Label.AskService" class="@BootstrapCSS.button_danger" />
                                    </div>
                            </form>
                       }
                
                   
            </td>
        </tr>
    }
</table>

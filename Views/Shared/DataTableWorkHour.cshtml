@model IEnumerable<DTO_WorkHour>

<vc:manager-subtitle caption="@text_WorkHour.HeaderWorkHour"></vc:manager-subtitle>
<table class="@BootstrapCSS.table">
    <tr>
        <th class="@BootstrapCSS.text_center">@text_WorkHour.LabelWorkHour</th>
        <th></th>
    </tr>
    @foreach (var index in Model)
    {
        <tr>
            <td >@index.Printable()</td>
            <td>
                <form method="post"
                    asp-antiforgery="true"
                      asp-controller="@controller_navigate.WorkHour"
                      asp-action="@controller_navigate.WorkHourController_Delete"
                    onsubmit="@string.Format(BootstrapCSS.js_confirm_delete_taxwage,index.Printable())"
                    >
                    
                    <input type="hidden" name="id" value="@index.ID"/>

                    <a asp-controller="@controller_navigate.WorkHour"
                    class="@BootstrapCSS.button_outline"
                       asp-action="@controller_navigate.WorkHourController_Edit"
                    asp-route-id="@index.ID">
                        @text_Label.Edit
                    </a>

                    <input type="submit" value="@text_Label.Delete" class="@BootstrapCSS.button_danger" />
                </form>

            </td>
        </tr>   
    }

</table>
<div class="@BootstrapCSS.margin_top_1 @BootstrapCSS.text_center">
    <a asp-controller="@controller_navigate.WorkHour"
    asp-action="@controller_navigate.WorkHourController_Create"
    class="@BootstrapCSS.button_primary">
        @text_Label.Create
</a>
</div>
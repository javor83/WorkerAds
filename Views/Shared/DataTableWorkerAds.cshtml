@model WorkerAdsList
<vc:manager-subtitle caption="@string.Format(text_Worker.AdsOf,Model.WorkerFullName)"></vc:manager-subtitle>

    @foreach (var index in Model.AdvList)
    {
        <div class="card mt-2">

                <form method="post"
                    asp-route-id="@index.ID"
                    asp-route-worker_id="@Model.WorkerID"
                    asp-antiforgery="true"
                    asp-controller="@controller_navigate.Worker"
                    asp-action="@controller_navigate.Worker_DeleteAds"
                    onsubmit="@string.Format(BootstrapCSS.js_confirm_delete_taxwage,index.PrintCategoryTax())">

                    <div class="card-header">
                        <b>@index.PrintCategoryTax()</b>
                        <a asp-controller="@controller_navigate.Worker"
                           asp-action="@controller_navigate.Worker_EditAds"
                           asp-route-id="@index.ID" class="@BootstrapCSS.button_outline">
                            @text_Label.Edit
                        </a>
                        <input type="submit" value="@text_Label.Delete" class="@BootstrapCSS.button_danger" />
                    </div>
                    <div class="card-body">@index.AdvText </div>
                    <div class="card-footer">@index.AdsDate()</div>


                </form>
           
           
        </div>
    }

    <div class="@BootstrapCSS.margin_top_1 @BootstrapCSS.text_center">
        <a asp-controller="@controller_navigate.Worker"
        asp-action="@controller_navigate.Worker_Index"
        class="@BootstrapCSS.button_outline">
        @text_Worker.BackToWorker
        </a>

    <a asp-controller="@controller_navigate.Worker"
       asp-action="@controller_navigate.Worker_EmptyAds"
       class="@BootstrapCSS.button_primary" asp-route-id="@Model.WorkerID">
        @text_Label.Create
    </a>
    </div>


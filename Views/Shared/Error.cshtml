@model UserFriendlyError


<table class="table table-striped">
    <tr>
        <td colspan="2">
            <span class="text-danger text-center">
                An error occurred while processing your request.
            </span>
        </td>
    </tr>
    @if (Model.ShowRequestId)
    {
        <tr>

            <td><b>Request ID</b></td>
            <td>@Model.RequestId</td>
        </tr>
    }

    <tr>
        <td><b>Exception</b></td>
        <td>@Model.Caption</td>
    </tr>
</table>
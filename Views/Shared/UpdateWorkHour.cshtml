@model WorkHourViewModel
<vc:manager-subtitle caption="@text_WorkHour.EditWorkHour"></vc:manager-subtitle>
<form method="post"
      asp-controller="@ControllerNavigateViewModel.WorkHour"
      asp-action="@ControllerNavigateViewModel.WorkHourController_Edit"
      asp-antiforgery="true">
    <input type="hidden" asp-for="@Model.ID" />
    <div asp-validation-summary="ModelOnly"></div>

    <div class="form-group">

        <label class="form-label">@text_WorkHour.LabelPHour</label>

        <input type="text" asp-for="@Model.Hour" placeholder="0..24" class="form-control" maxlength="2" />
        <span asp-validation-for="@Model.Hour"></span>

    </div>
    <div class="form-group">

        <label class="form-label">@text_WorkHour.LabelPMinute</label>

        <input type="text" asp-for="@Model.Minute" placeholder="0..59" class="form-control" maxlength="2" />
        <span asp-validation-for="@Model.Minute"></span>

    </div>
    <div class="@BootstrapCSS.margin_top_1 @BootstrapCSS.text_center">

        <a asp-controller="@ControllerNavigateViewModel.WorkHour"
           asp-action="@ControllerNavigateViewModel.WorkHour_Index"
           class="@BootstrapCSS.button_outline">
            @text_Label.Cancel
        </a>
        <input type="submit" value="@text_Label.Save" class="@BootstrapCSS.button_primary @BootstrapCSS.display_inline" />
    </div>
</form>


@using GCommon.Contracts
@inject ILocalProfiles log_as

<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
    <div class="container-fluid">
        <a class="navbar-brand" asp-area="" asp-controller="@ControllerNavigateViewModel.Home" asp-action="@ControllerNavigateViewModel.Home_Index">@Localizer["AppName"]</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
            <ul class="navbar-nav flex-grow-1">
                <li class="nav-item">
                    <a class="nav-link" 
                    asp-area="" 
                       asp-controller="@ControllerNavigateViewModel.Home"
                       asp-action="Index">@Localizer["Ads"]</a>
                </li>
                @if (log_as.InRoleAdmin())
                {
                    <li class="nav-item dropdown">
                    
                        <a class="nav-link  dropdown-toggle" asp-area="" asp-controller="@ControllerNavigateViewModel.Home" asp-action="@ControllerNavigateViewModel.Home_Index" role="button" data-bs-toggle="dropdown">@Localizer["Admin"]</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-action="@ControllerNavigateViewModel.WageTax_Index" asp-controller="@ControllerNavigateViewModel.WageTax">@Localizer["HeaderWagetax"]</a></li>
                            <li><a class="dropdown-item" asp-action="@ControllerNavigateViewModel.WorkCategory_Index" asp-controller="@ControllerNavigateViewModel.WorkCategory">@Localizer["HeaderWorkCategory"]</a></li>

                            <li><a class="dropdown-item" asp-action="@ControllerNavigateViewModel.WorkHour_Index" asp-controller="@ControllerNavigateViewModel.WorkHour">@Localizer["HeaderWorkHour"]</a></li>

                            <li><a class="dropdown-item" asp-action="@ControllerNavigateViewModel.Worker_Index" asp-controller="@ControllerNavigateViewModel.Worker">@Localizer["HeaderWorker"]</a></li>
                            <li><a class="dropdown-item" asp-action="@ControllerNavigateViewModel.Orders_Index" asp-controller="@ControllerNavigateViewModel.Orders">@Localizer["Orders"]</a></li>

                            
                        
                        </ul>
                    </li>
                }
            </ul>
            <partial name="_LoginPartial" />

            <partial name="_CultureSelector" />

        </div>
    </div>
    
</nav>
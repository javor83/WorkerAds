@model WageTaxViewModel
<vc:manager-subtitle caption="@text_WageTax.EditWageTaxUnit"></vc:manager-subtitle>
<form method="post"
      asp-controller="@ControllerNavigateViewModel.WageTax"
      asp-action="@ControllerNavigateViewModel.WageTax_Update"
    asp-antiforgery="true">
    <div asp-validation-summary="ModelOnly"></div>
    <input type="hidden" asp-for="@Model.ID" />
    <div class="form-group">
        <label asp-for="@Model.Name">@text_WageTax.LabelWageTaxUnit</label>
        <input type="text" asp-for="@Model.Name" class="form-control" />
        <span asp-validation-for="@Model.Name"></span>
    </div>
    <div class="@BootstrapCSS.text_center @BootstrapCSS.margin_top_1">
        <a asp-action="@ControllerNavigateViewModel.WageTax_Index"
           asp-controller="@ControllerNavigateViewModel.WageTax"
           class="@BootstrapCSS.button_outline">
            @text_Label.Cancel
        </a>

        <input type="submit" value="@text_Label.Save" class="@BootstrapCSS.button_primary @BootstrapCSS.display_inline" />
    </div>
</form>
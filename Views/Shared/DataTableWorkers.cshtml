@model IEnumerable<WorkerSelectViewModel>
<vc:manager-subtitle caption="@text_Worker.HeaderWorker"></vc:manager-subtitle>
<table class="@BootstrapCSS.table">
    <tr>
        <th class="@BootstrapCSS.text_center">@text_Worker.WorkerImage (@Model.Count())</th>
        <th class="@BootstrapCSS.text_center">@text_Worker.WorkerDetails</th>
        <th></th>
    </tr>
    @foreach (var k in Model)
    {
        <tr>
            <td>
                <img src="@k.Photo.ImgSrc_PreviewWorker()" class="@BootstrapCSS.img_thumbnail_worker" />
            </td>
            <td>
               
                    <div>
                        <b>@k.FullName()</b>
                    </div>
                   <div>
                    <b>@text_Worker.WorkerPhone</b>  @k.Phone
                   </div>
                <div>
                    <b>@text_Worker.WorkerEmail</b>  @k.Email
                </div>
               
               
                <ul>
                    @foreach (var cap in k)
                    {
                        <li>@cap.Print()</li>    
                    }
                </ul>
                <div>
                    <a asp-action="@ControllerNavigateViewModel.Worker_Capability"
                       asp-controller="@ControllerNavigateViewModel.Worker"
                        asp-route-id="@k.ID"
                        class="@BootstrapCSS.button_outline">
                        @text_Worker.Capability
                    </a>
                    <a asp-action="@ControllerNavigateViewModel.Worker_Ads"
                       asp-controller="@ControllerNavigateViewModel.Worker"
                       asp-route-id="@k.ID"
                       class="@BootstrapCSS.button_outline">
                        @text_Worker.Ads
                    </a>


                </div>
            </td>
            <td>
                <form method="post"
                      asp-controller="@ControllerNavigateViewModel.Worker"
                      asp-action="@ControllerNavigateViewModel.WorkCategory_Delete"
                    asp-antiforgery="true"
                    onsubmit="@string.Format(BootstrapCSS.js_confirm_delete_taxwage,k.FullName())"
                    >
                    <input type="hidden" name="id" value="@k.ID"/>
                    <a asp-action="@ControllerNavigateViewModel.Worker_Edit"
                       asp-controller="@ControllerNavigateViewModel.Worker"
                    asp-route-id="@k.ID"
                    class="@BootstrapCSS.button_outline">
                        @text_Label.Edit
                    </a>
                    <input type="submit" value="@text_Label.Delete" class="@BootstrapCSS.button_danger" />
                </form>
            </td>
        </tr>
    }
</table>
<div class="@BootstrapCSS.margin_top_1 @BootstrapCSS.text_center">
    <a asp-controller="@ControllerNavigateViewModel.Worker" 
    asp-action="@ControllerNavigateViewModel.Worker_Create"
    class="@BootstrapCSS.button_primary @BootstrapCSS.display_inline">
        @text_Label.Create
    </a>
</div>
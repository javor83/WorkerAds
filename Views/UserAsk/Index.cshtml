@using GCommon.Services
@model ManageAskViewModel
<vc:manager-subtitle caption="@text_UserAsk.OrderedItems"></vc:manager-subtitle>
@{

    IEnumerable<AdsPersonViewModel> ordered_items = ViewData[ManageAsk.ORDERED_ITEMS] as IEnumerable<AdsPersonViewModel>;

}


<table class="@BootstrapCSS.table">
    @foreach (var item in ordered_items)
    {

        <tr class="table-success">
            <td>
                <b>@item.AdvTitle</b>
                </td>
            <td>
               
                <form method="post" asp-antiforgery="true"
                asp-controller="@ControllerNavigateViewModel.UserAsk"
                asp-action="@ControllerNavigateViewModel.UserAsk_RemoveAsk"
                asp-route-id="@item.DeclareWorkerFreeID">
                <input type="submit" value="@text_Label.Delete" class="@BootstrapCSS.button_danger"/>
                </form>
            </td>
        </tr>
        <tr>
            <td>@text_Worker.WorkerFName</td>
            <td>@item.FullName()</td>
        </tr>
        <tr>
            <td>@text_Worker.WorkerPhone</td>
            <td>@item.Phone</td>
        </tr>
        <tr>
            <td>@text_Worker.WorkerEmail</td>
            <td>@item.Email</td>
        </tr>
        <tr>
            <td>@text_WorkCategory.LabelWorkCategory</td>
            <td>@item.WhatToDo()</td>
        </tr>
        <tr style="margin-bottom:15px;">
            <td>@text_WorkHour.LabelWorkHour</td>
            <td> @item.EveryDay()</td>
        </tr>

       
     
     
}
</table>
@if (ordered_items.Any())
{
    <form 
        method="post" 
        asp-action="@ControllerNavigateViewModel.UserAsk_Index" 
        asp-controller="@ControllerNavigateViewModel.UserAsk" 
        asp-antiforgery="true">
        <input type="hidden" asp-for="@Model.ASPNETUSER_ID" />
        <div asp-validation-summary="ModelOnly"></div>
            @foreach (var k in Model.AdvID)
            {
            <input type="hidden" name="AdvID[]" value="@k" />
            }
        <div class="form-group">
            <label class="form-label" asp-for="@Model.Phone"></label>
            <input type="text" asp-for="@Model.Phone" class="form-control" />
            <span asp-validation-for="@Model.Phone"></span>
        </div>
        <div class="form-group">
            <label class="form-label" asp-for="@Model.OrderDetails"></label>
            <textarea asp-for="@Model.OrderDetails" class="form-control textdetails"></textarea>
            <span asp-validation-for="@Model.OrderDetails"></span>
        </div>
        <div class="text-center form-group @BootstrapCSS.margin_top_1">
            <input type="submit" class="@BootstrapCSS.button_primary d-inline" value="@text_UserAsk.SendOrder" />
        </div>
    </form>
}
